# AI-Editor environment configuration
# Copy this file to ".env" in the project root and replace placeholder values.
#
# Do not commit the real ".env" file or any credential JSON/token files.
# When running in Docker, mount any credential JSON files into the container
# (for example under /app/secrets) and point the *_FILE variables below to them.

# Rendering provider
RENDER_PROVIDER=ffmpeg

# Local FFmpeg binaries
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Optional: explicit font file used by FFmpeg drawtext overlays.
# Recommended on Windows to avoid Fontconfig errors.
FFMPEG_FONT_FILE=C:\Windows\Fonts\arial.ttf

# Optional: disable baking reference transitions into clips before FFmpeg concat (default: on).
# Keep enabled for safe hard cuts until transition rendering is fully validated.
FFMPEG_DISABLE_TRANSITIONS=1

# Only required when RENDER_PROVIDER=shotstack
# SHOTSTACK_KEY="your-shotstack-api-key"
# SHOTSTACK_HOST="https://api.shotstack.io/stage"

# Optional but recommended if you use the chat brief builder / overlay planning
GROQ="your-groq-api-key"
HF_API_KEY=        # free at huggingface.co/settings/tokens
# Optional: server-side Google Drive OAuth files
# If omitted, the app will look for drive-oauth-client-secret.json and drive-token.json
DRIVE_CLIENT_SECRET_FILE=""
DRIVE_TOKEN_FILE=""

# Optional: redirect URI for the Google Drive OAuth callback
DRIVE_OAUTH_REDIRECT_URI="http://localhost:10000/google-drive/oauth/callback"

# Optional: service account file path when DRIVE_AUTH_MODE=service_account
# If omitted, the app will look for service-account.json in the repo root
GOOGLE_APPLICATION_CREDENTIALS=""

# Optional: default source folder when loading videos directly from Drive
VIDEO_FOLDER=""

# Optional: upload destination folder settings for Drive-hosted Shotstack assets
DRIVE_UPLOAD_FOLDER_ID=""
DRIVE_UPLOAD_FOLDER_NAME="AI-Editor-Shotstack-Assets"
DRIVE_UPLOAD_FOLDER_PARENT_ID=""
DRIVE_DEFAULT_FOLDER_ID=""

# Optional: default refit mode for shorts
REFIT_MODE="crop_center"

# Optional: YouTube upload OAuth files
# If omitted, the app will look for youtube-client-secret.json and youtube-token.json
YOUTUBE_CLIENT_SECRET_FILE=""
YOUTUBE_TOKEN_FILE=""

# Optional: use console OAuth flow for YouTube instead of local browser callback
YOUTUBE_OAUTH_USE_CONSOLE="false"

# Optional: render download robustness before YouTube upload
YOUTUBE_RENDER_DOWNLOAD_CONNECT_TIMEOUT="20"
YOUTUBE_RENDER_DOWNLOAD_READ_TIMEOUT="600"
YOUTUBE_RENDER_DOWNLOAD_RETRIES="3"

# Optional: yt-dlp section strategy
# - fast: prefer quicker section download
# - accurate: force the slower precise-cut path
YTDLP_SECTION_MODE="fast"
